# Copy to .env for local smoke testing only. Never commit .env or share it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
PROCURETRACK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
APP_ENV=development
NEXORA_SETUP_KEY=SET_A_LONG_RANDOM_SETUP_KEY_FOR_FIRST_ADMIN_CREATION
# Google Cloud Console OAuth Web Client values
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/drive/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXORA_TOKEN_ENCRYPTION_KEY=
# Long random token used only by the office-PC sync agent
NEXORA_SYNC_TOKEN=
